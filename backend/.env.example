# ===== ExamGuard backend — sao chép thành backend/.env =====

# Tài khoản quản trị tạo lần đầu (để trống ADMIN_PASSWORD -> tạo ngẫu nhiên, lưu ở data/admin_password.txt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Khóa ký token; trống -> tự tạo và lưu ở data/.secret_key
SECRET_KEY=

# CSDL: trống -> SQLite trong data/. Triển khai: postgresql+psycopg://user:pass@host:5432/examguard
DATABASE_URL=
# Hàng đợi: trống -> trong tiến trình. Nhiều tiến trình/máy: redis://host:6379/0 (Redis Streams)
REDIS_URL=
DATA_DIR=data
# Địa chỉ trang thi (để FaceReg chuyển thí sinh về) và các origin được gọi API
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ----- FaceReg (dịch vụ xác thực khuôn mặt riêng) -----
# URL server gọi nội bộ, URL trình duyệt thí sinh mở, và ADMIN_TOKEN của FaceReg (không bao giờ gửi ra trình duyệt).
# Bên FaceReg đặt: CHECKIN_SUCCESS_URL=<PUBLIC_URL>/exam/facereg-callback?ftoken={token}
FACEREG_URL=
FACEREG_PUBLIC_URL=
FACEREG_ADMIN_TOKEN=
# false = cho phép kỳ thi chạy không cần FaceReg (thử nghiệm)
FACEREG_REQUIRED=true
# Xác thực lại giữa giờ bằng ảnh crop mặt: ngẫu nhiên trong khoảng (giây)
REVERIFY_MIN_SECONDS=60
REVERIFY_MAX_SECONDS=180

# ----- Mô hình (từ notebooks/) -----
YOLO_MODEL=models/proctor_yolo.onnx
FUSION_MODEL=models/fusion_gru.onnx
# Nhóm đặc trưng -> tên lớp của mô hình YOLO (JSON), để trống dùng mặc định
YOLO_CLASSES=
YOLO_BATCH=32
FRAME_QUEUE_MAX=2000

# ----- Gắn cờ & rà soát -----
FLAG_THRESHOLD=60
# Ngưỡng theo hạng máy (notebook 03 mục 7 tính sẵn chuỗi này)
TIER_THRESHOLDS=low:70,mid:60,high:60
# Tỉ lệ phiên KHÔNG bị gắn cờ đưa vào mẫu rà soát ngẫu nhiên (ước lượng recall)
REVIEW_SAMPLE_RATE=0.05
# Giữ khung mờ mặt làm bằng chứng khi có cờ: flagged | none
EVIDENCE_FRAMES=flagged
EVIDENCE_RETENTION_DAYS=30
